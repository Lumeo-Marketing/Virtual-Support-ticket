# PostgreSQL connection. Create the database and role described in README.md first.
DATABASE_URL=postgresql://lumeo_user:change_me@localhost:5432/lumeo_support
PG_POOL_MAX=10
# Set to true only for a PostgreSQL server that requires TLS.
PGSSL=false

# Change seed passwords before sharing or deploying the app.
ADMIN_EMAIL=admin@lumeo.com
ADMIN_PASSWORD=Admin123!
STAFF_EMAIL=staff@lumeo.com
STAFF_PASSWORD=Staff123!
SUPER_ADMIN_EMAIL=owner@lumeo.com
SUPER_ADMIN_PASSWORD=Owner123!
SESSION_SECRET=+yIJbmbw9Ibo8e5lUrNl49CjKjlaiJCFphjA6rbjhhlQ4g4fVlvkHF1Ygu56Zo6+

# Optional SMTP. When omitted, notifications are stored in the portal and logged to the server console.
APP_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SUPPORT_REPLY_TO=
# Ticket notification recipients; separate multiple addresses with commas.
SUPPORT_ADMIN_EMAILS=moses@twinklehealthcare.com
